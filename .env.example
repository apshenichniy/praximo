# Root secrets file (gitignored as `.env`). The agent does all devops; the human
# only supplies this file (ADR 0003). Copy to `.env` and fill in real values.

# --- Cloudflare (Alchemy provider auth) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The `praximo.io` zone id, needed to onboard the `mail.praximo.io` sending
# subdomain for Email Service (#58). The zone itself is deliberately NOT a
# resource in this stack — public praximo.io stays outside Alchemy — so its id
# is supplied rather than created. Only the canonical stage reads it; personal
# stages send through the subdomain that stage already onboarded.
CLOUDFLARE_ZONE_ID=

# --- Neon (Alchemy provider auth) ---
NEON_API_KEY=

# --- Dev database + tooling (db:reset, repository integration tests) ---
# The dev Neon branch connection URI. Alchemy generates it and injects it into
# the Workers as a secret binding at deploy; paste the same dev-branch URI here
# for `bun run db:reset` and the @praximo/db integration tests. NEVER the prod
# branch — prod's URI is only ever Alchemy-injected, never written to this file.
DATABASE_URL=

# One or more platform-admin Telegram ids, separated by commas. db:reset trims
# whitespace, rejects empty/malformed entries, and seeds every id as an equal admin.
ADMIN_TELEGRAM_IDS=

# --- Manager bot (platform-owned; ADR 0004) ---
# The dev manager bot's token from @BotFather (#80). Alchemy binds it as a
# secret on the Workers that need it: `admin` validates Manager Bot Mini App
# `initData`, and `bot` constructs outbound delivery. Coach validates Ed25519
# Mini App signatures and never receives this secret. Setup scripts also read it.
# The active development Manager Bot is @PraximoBot and its menu opens
# `https://admin.praximo.io/admin`.
MANAGER_BOT_TOKEN=
# Public @BotFather username without `@`, used to construct onboarding links.
MANAGER_BOT_USERNAME=
# Random Bot API-compatible secret used to authenticate manager webhook calls.
MANAGER_BOT_WEBHOOK_SECRET=
# Deployed bot Worker origin. Used by `bun run manager-bot:set-webhook`, and
# bound into the bot Worker itself: the coach-bot health sweep runs on a cron,
# where there is no request to read an origin off, and a repaired bot has its
# webhook re-armed at this origin (#55). Leave it empty and repairs still
# refresh credentials — they just leave webhooks exactly as Telegram has them.
MANAGER_BOT_WEBHOOK_URL=

# Base64url-encoded 32-byte AES-256-GCM key for per-coach bot credentials.
# Generate independently for each stage; never print or commit the real value.
COACH_BOT_CREDENTIAL_KEY=

# Stable HTTPS Mini App URL installed as every coach bot's in-chat menu button.
# Provisioning appends `?b=<telegramBotId>` per bot, so a launch names the bot it
# came from and the coach path can verify its signature before any lookup.
COACH_MINI_APP_URL=https://coach.praximo.io/

# The client app's origin — every surface a client meets, plus the legal texts
# (#191). In a deployed stage this is NOT read from here: Alchemy binds the
# client Worker's own URL, so it can never name a host the stack did not deploy.
# This value is for local Coach development only. Deployed Workers receive the
# Client Worker's own URL from Alchemy.
CLIENT_APP_URL=http://localhost:3003

# Optional, local development only. **A real Telegram user id from your own dev
# database** — the coach the launch is minted for, not a placeholder. The launch
# is genuinely Ed25519-signed and runs through the real verifier and the real
# database gate, so an id no member row carries is refused exactly like a
# stranger's: the app renders "Open Praximo from your bot" and nothing says why.
#
# Read it from the connected workspace of the branch you are pointed at:
#
#   select m.telegram_user_id, b.telegram_bot_id, b.username
#   from member m join bot b on b.workspace_id = m.workspace_id
#   where b.connection_status = 'connected';
#
# Coach dev opens `http://localhost:3002/?b=<telegram_bot_id>` automatically.
# The `?b=` names the bot the signature is checked against, and the two values
# have to identify the same connected coach and Workspace Bot.
# DEV_COACH_TELEGRAM_ID=
# DEV_COACH_TELEGRAM_BOT_ID=

# Which of Telegram's two published Ed25519 public keys the coach Mini App path
# verifies launches against (ADR 0006). `production` unless this stage is
# pointed at Telegram's test data centre. Not a secret and not a key — the keys
# themselves are in source, and this only chooses between them.
TELEGRAM_ENV=production

# Private R2 object key for the platform-owned default coach-bot avatar — the
# picture every coach bot is provisioned with (#138). The same logical key may
# be used in each stage's isolated bucket.
#
# The object must be a square 512×512 JPEG, which is exactly what
# `bun run branding:avatar:set --stage <stage> --file <image> --key <this key>`
# produces from any JPEG/PNG/WebP/SVG source. Changing the default avatar is
# that upload and nothing else: no code change, no deploy. A stage whose object
# is missing still onboards coaches — their bots simply start without a photo,
# and the bot Worker logs the key it could not read.
DEFAULT_COACH_BOT_AVATAR_R2_KEY=branding/default-coach-avatar.jpg

# Optional. The stage db:reset targets; defaults to `dev_<user>`. db:reset
# hard-refuses `prod` regardless of this value.
# APP_STAGE=dev_alexander
