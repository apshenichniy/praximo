# Root secrets file (gitignored as `.env`). The agent does all devops; the human
# only supplies this file (ADR 0003). Copy to `.env` and fill in real values.

# --- Cloudflare (Alchemy provider auth) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Neon (Alchemy provider auth) ---
NEON_API_KEY=

# --- Dev database + tooling (db:reset, repository integration tests) ---
# The dev Neon branch connection URI. Alchemy generates it and injects it into
# the Workers as a secret binding at deploy; paste the same dev-branch URI here
# for `bun run db:reset` and the @praximo/db integration tests. NEVER the prod
# branch — prod's URI is only ever Alchemy-injected, never written to this file.
DATABASE_URL=

# One or more platform-admin Telegram ids, separated by commas. db:reset trims
# whitespace, rejects empty/malformed entries, and seeds every id as an equal admin.
ADMIN_TELEGRAM_IDS=

# --- Manager bot (platform-owned; ADR 0004) ---
# The dev manager bot's token from @BotFather (#80). Alchemy binds it as a
# secret on both Workers that need it: `web` validates admin Mini App `initData`
# by HMAC, while `bot` constructs the outbound manager-bot sender. The setup and
# canary scripts also read it locally. The canonical dev menu opens
# `https://stage.praximo.io/admin`; the prod bot is a distinct token,
# Alchemy-only.
MANAGER_BOT_TOKEN=
# Public @BotFather username without `@`, used to construct onboarding links.
MANAGER_BOT_USERNAME=

# Dedicated HMAC secret for coach-onboarding start parameters. Do not reuse the
# manager bot token or another application secret.
COACH_ONBOARDING_TOKEN_SECRET=

# Private R2 object key for the platform-owned default coach-bot avatar. The
# same logical key may be used in each stage's isolated bucket.
DEFAULT_COACH_BOT_AVATAR_R2_KEY=branding/default-coach-avatar.jpg

# Optional. The stage db:reset targets; defaults to `dev_<user>`. db:reset
# hard-refuses `prod` regardless of this value.
# APP_STAGE=dev_alexander
