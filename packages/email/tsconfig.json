{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@praximo/tooling/tsconfig/library.json",
  "compilerOptions": {
    // Templates are JSX rendered to a string on the server, never mounted, so
    // the React transform is needed but Vite's browser preset is not — `vite.json`
    // would drag in `vite/client` ambient types this package has no use for.
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    // `node` for the manifest read in the barrel-guard test; nothing in `src`
    // outside a test touches a Node API, and the Worker bundle never sees one.
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
