{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Browser + Vite app surface. Extends the one strict base contract (ADR
    // 0002); adds the DOM libs, the React JSX transform, and Vite's client
    // ambient types that a Worker/library tsconfig deliberately omits. `paths`
    // and `include` stay in the consuming app's tsconfig — path mappings anchor
    // to the file that declares them, so they cannot live in this shared preset.
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  }
}
