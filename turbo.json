{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "check": {
      "dependsOn": ["^check"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^check"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^check"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    }
  }
}
