{
  "name": "@praximo/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist src/index.ts --name praximo-pipeline --compatibility-date 2026-07-19 --compatibility-flags nodejs_compat",
    "check": "tsc --noEmit && oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@praximo/analysis": "workspace:*",
    "@praximo/db": "workspace:*",
    "@praximo/domain": "workspace:*",
    "@praximo/telegram": "workspace:*",
    "@praximo/transcription": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@praximo/tooling": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
